{
  "name": "llm-arena",
  "version": "0.1.0",
  "description": "Open-source Screeps-like PvP where LLM-written bots battle. Deterministic integer engine; a leaderboard measures which (free) model plays best.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/serve.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node src/runner/demo.js",
    "catalog": "node --env-file-if-exists=.env scripts/catalog.js",
    "matches": "node --env-file-if-exists=.env scripts/run-matches.js",
    "phase0": "node --env-file-if-exists=.env scripts/phase0.js",
    "fill-pool": "node --env-file-if-exists=.env scripts/fill-pool.js"
  },
  "exports": {
    "./engine": "./src/engine/engine.js",
    "./mapgen": "./src/engine/mapgen.js",
    "./runner": "./src/runner/match.js",
    "./sandbox": "./src/sandbox/quickjs.js",
    "./sandboxed-match": "./src/runner/sandboxed-match.js",
    "./isolated": "./src/runner/isolated.js",
    "./extract-code": "./src/runner/extract-code.js"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "quickjs-emscripten": "0.32.0",
    "sucrase": "3.35.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
