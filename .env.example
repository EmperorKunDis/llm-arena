# OpenRouter key — server only. Use a freshly ROTATED key with a credit limit set on it.
OPENROUTER_API_KEY=
# Daily request budget of the OpenRouter account (50 without credits, 1000 after a 10 USD top-up).
LLM_ARENA_ACCOUNT_DAILY=50
# Live "generate a bot" button: per-IP daily limit and global daily cap (reserved from the account budget).
LLM_ARENA_DAILY_LIMIT=1
LLM_ARENA_GLOBAL_DAILY_LIMIT=10
# Secret for HMAC-hashing visitor IPs (never stored in clear). Generate: openssl rand -hex 32
LLM_ARENA_IP_SECRET=
# SQLite database path.
LLM_ARENA_DB=data/arena.sqlite
